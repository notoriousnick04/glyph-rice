#!/usr/bin/env python3
# cava as dots, like Nothing's Glyph Matrix: terminal cava draws only bars, so we take
# raw numbers from it and print the "●" matrix ourselves. Sound and smoothing — from adjacent config. Exit — Ctrl+C
import configparser, os, shutil, subprocess, sys, tempfile

CONFIG = os.path.join(os.path.dirname(os.path.realpath(__file__)), "config")
ON, OFF = "●", "\x1b[90m●\x1b[39m"  # dimmed — grey color8 of theme (light in light theme), like LED of off matrix


def run(cols, rows):
    cfg = configparser.ConfigParser(interpolation=None, strict=False)
    cfg.read(CONFIG)
    cfg.remove_section("output")
    cfg.read_dict({
        # dot + space: terminal cell is twice as wide as line, so grid comes out square
        # even: stereo cava (default) doesn't take odd number of bars
        "general": {"bars": str(cols // 4 * 2)},
        "output": {"method": "raw", "raw_target": "/dev/stdout", "data_format": "ascii",
                   "ascii_max_range": str(rows), "bar_delimiter": "59", "frame_delimiter": "10"},
    })
    with tempfile.NamedTemporaryFile("w", suffix=".conf") as f:
        cfg.write(f)
        f.flush()
        with subprocess.Popen(["cava", "-p", f.name], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as p:
            sys.stdout.write("\x1b[2J")  # window shrank — without this old frame stays on right/bottom
            for line in p.stdout:
                if shutil.get_terminal_size() != (cols, rows):
                    p.terminate()
                    return True  # window changed — restart for new size
                try:
                    v = [int(x) for x in line.strip().split(";") if x]
                except ValueError:
                    continue  # before error cava writes window title to stdout (\e]0;cava\a) — not a frame, error below
                rows_out = (" ".join(ON if h >= r else OFF for h in v) for r in range(rows, 0, -1))
                sys.stdout.write("\x1b[H" + "\n".join(rows_out))
                sys.stdout.flush()
            sys.exit(p.stderr.read() or None)  # cava crashed — show why when screen returns


if sys.argv[1:]:
    os.execvp("cava", ["cava", *sys.argv[1:]])  # with flags (cava -v, -p …) — plain cava

sys.stdout.write("\x1b[?1049h\x1b[?25l")  # own screen, no cursor
try:
    while run(*shutil.get_terminal_size()):
        pass
except KeyboardInterrupt:
    pass
finally:
    sys.stdout.write("\x1b[?25h\x1b[?1049l")
